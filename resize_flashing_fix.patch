--- a/src/core/wnd.h
+++ b/src/core/wnd.h
@@ -130,6 +130,25 @@ public:
 	virtual void on_init_children() {}
 	virtual void on_paint() {}
+	
+	// New resize handling method
+	virtual void on_resize(int new_width, int new_height) {
+		// Update window rectangle for root window
+		if (!m_parent) {
+			m_wnd_rect.m_right = m_wnd_rect.m_left + new_width - 1;
+			m_wnd_rect.m_bottom = m_wnd_rect.m_top + new_height - 1;
+		}
+		
+		// Propagate to children
+		c_wnd* child = m_top_child;
+		while (child) {
+			child->on_resize(new_width, new_height);
+			child = child->m_next_sibling;
+		}
+		
+		// Trigger repaint after resize
+		show_window(true);
+	}
+	
 	virtual void show_window(bool pre_paint = false)
 	{
 		if (ATTR_VISIBLE == (m_attr & ATTR_VISIBLE))
@@ -137,6 +156,11 @@ public:
 			if (pre_paint)
 			{
 				on_paint();
+				
+				// Batch flush for better performance during resize
+				if (m_surface) {
+					m_surface->begin_batch_flush();
+				}
 			}
 			else if (m_parent == 0) //root wnd
 			{
@@ -152,6 +176,11 @@ public:
 					child = child->m_next_sibling;
 				}
 			}
+			
+			// End batch flush
+			if (pre_paint && m_surface) {
+				m_surface->end_batch_flush();
+			}
 		}
 	}
 
