diff --git a/src/core/display.h b/src/core/display.h
index 1234567..abcdefg 100644
--- a/src/core/display.h
+++ b/src/core/display.h
@@ -158,6 +158,15 @@ protected:
 
 	virtual int flush_screen(int left, int top, int right, int bottom, void* fb, int fb_width)
 	{
+		// Anti-flashing optimization: Skip flush during rapid updates
+		static long last_flush_time = 0;
+		static int flush_count = 0;
+		long current_time = get_time_in_second() * 1000;
+		
+		if (current_time - last_flush_time < 16) { // Less than 16ms (60fps)
+			flush_count++;
+			if (flush_count > 3) return 0; // Skip excessive flushes
+		} else {
+			flush_count = 0;
+		}
+		last_flush_time = current_time;
+
 		if ((0 == m_phy_fb) || (0 == fb))
 		{
 			return -1;
@@ -409,6 +418,15 @@ public:
 
 	int flush_screen(int left, int top, int right, int bottom)
 	{
+		// Batch flush optimization for resize scenarios
+		static bool batch_mode = false;
+		static c_rect batch_rect;
+		
+		if (batch_mode) {
+			// Expand batch rectangle to include this flush
+			batch_rect.m_left = MIN(batch_rect.m_left, left);
+			batch_rect.m_top = MIN(batch_rect.m_top, top);
+			batch_rect.m_right = MAX(batch_rect.m_right, right);
+			batch_rect.m_bottom = MAX(batch_rect.m_bottom, bottom);
+			return 0;
+		}
+
 		if (!m_is_active)
 		{
 			return -1;
@@ -425,6 +443,20 @@ public:
 		return 0;
 	}
 
+	// New methods for batch operations
+	void begin_batch_flush() {
+		static bool batch_mode = true;
+		static c_rect batch_rect = c_rect(m_width, m_height, 0, 0);
+	}
+	
+	void end_batch_flush() {
+		static bool batch_mode = false;
+		if (batch_rect.m_left < batch_rect.m_right && batch_rect.m_top < batch_rect.m_bottom) {
+			m_display->flush_screen(batch_rect.m_left, batch_rect.m_top, 
+								  batch_rect.m_right, batch_rect.m_bottom, m_fb, m_width);
+		}
+	}
+
 	bool is_active() { return m_is_active; }
 	c_display* get_display() { return m_display; }
 
diff --git a/src/core/wnd.h b/src/core/wnd.h
